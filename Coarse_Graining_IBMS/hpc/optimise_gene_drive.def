Bootstrap: docker
From: python:3.11-slim

# Singularity/Apptainer image for optimise_gene_drive.py (multi-objective gene-drive BO).
# Bakes the code (not data/) so the image stays small and the LFS surrogate blobs are
# excluded. The runtime objective drives the IBM directly, so no model files are needed.
# At runtime, bind a writable host directory over .../Coarse_Graining_IBMS/data.

%files
    requirements.txt                       /opt/Mosquitos_Bonsall/requirements.txt
    Coarse_Graining_IBMS/src               /opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/src
    Coarse_Graining_IBMS/pyproject.toml    /opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/pyproject.toml

%post
    apt-get update && apt-get install -y --no-install-recommends build-essential \
        && rm -rf /var/lib/apt/lists/*          # SyncRNG / line_profiler need a compiler
    python -m pip install --upgrade pip
    pip install --no-cache-dir -r /opt/Mosquitos_Bonsall/requirements.txt
    mkdir -p /opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/data   # writable bind mount point
    chmod -R a+rX /opt/Mosquitos_Bonsall

%environment
    export PYTHONPATH=/opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/src
    export MPLBACKEND=Agg
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    cd /opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/src
    exec python optimise_gene_drive.py "$@"

%help
    Multi-objective Bayesian optimisation for underdominance gene drives.
    Usage:
        singularity run \
            --bind <host_data_dir>:/opt/Mosquitos_Bonsall/Coarse_Graining_IBMS/data \
            optimise_gene_drive.sif --prop-gg-low 0.3 --prop-gg-high 0.5 [--base-seed N]
    Outputs (under the bound data dir):
        ibm_output/low<low>_high<high>/gene_drive_pareto_frontier_points_*.csv
        models/optimisation/low<low>_high<high>/gene_drive_bo_model_*.pt
